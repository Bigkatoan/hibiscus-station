# Hibiscus Station (Docker). deploy/install.sh writes this file; edit it, then `hibiscus-station-ctl up`.

# Image: ghcr.io/bigkatoan/hibiscus-station:<version>-<variant>, variant cpu | cuda | jetson.
STATION_IMAGE=ghcr.io/bigkatoan/hibiscus-station
STATION_TAG=1.0.0a1-cpu
# The tag that ran before the last `hibiscus-station-ctl update` (used by `rollback`).
STATION_PREVIOUS_TAG=
# Extra compose files per variant: compose.yml (cpu), compose.yml:compose.cuda.yml, compose.yml:compose.jetson.yml
COMPOSE_FILE=compose.yml

# Host folders (created by install.sh, owned by PUID:PGID). Calibration stays in lerobot's default
# place so lerobot / LeLab on the same machine see the same files.
STATION_DATA=/home/USER/.hibiscus/station
STATION_CALIBRATION=/home/USER/.cache/huggingface/lerobot/calibration
# Backups made by `hibiscus-station-ctl backup|update`.
STATION_BACKUPS=/home/USER/.local/share/hibiscus-station/backups

# The host user the container runs as, and the host groups of serial ports and cameras
# (`getent group dialout video`).
PUID=1000
PGID=1000
DIALOUT_GID=20
VIDEO_GID=44

# Network. Default: 127.0.0.1 only (open http://127.0.0.1:18210 on this machine, or through an
# SSH tunnel). LAN mode needs all three: STATION_BIND=0.0.0.0 (or this machine's LAN address), a
# fixed token (`python3 -c 'import secrets; print(secrets.token_urlsafe(32))'`) and the names the
# browser uses (comma-separated, e.g. robot-pi.local,192.168.1.40). Read docs/deploy.md first.
STATION_BIND=127.0.0.1
STATION_PORT=18210
HIBISCUS_STATION_TOKEN=
HIBISCUS_STATION_ALLOWED_HOSTS=

# Extra arguments for hibiscus-station (e.g. --mock for a demo without hardware, --verbose).
STATION_EXTRA_ARGS=
TZ=Etc/UTC
