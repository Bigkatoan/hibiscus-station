{
  "name": "hibiscus-station-web",
  "private": true,
  "version": "0.2.10",
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.12 <23"
  },
  "scripts": {
    "dev": "vite",
    "dev:mock": "vite --mode mock",
    "build": "tsc --noEmit && vite build && node scripts/check-csp-bundle.mjs dist/assets",
    "build:mock": "tsc --noEmit && vite build --mode mock",
    "preview": "vite preview",
    "preview:mock": "vite preview --mode mock",
    "gen:api": "openapi-typescript ../openapi.json --default-non-nullable=false -o src/station/api/schema.d.ts && prettier --write src/station/api/schema.d.ts",
    "check:api": "openapi-typescript ../openapi.json --default-non-nullable=false -o /tmp/station-schema.d.ts && prettier --config .prettierrc.json --write /tmp/station-schema.d.ts >/dev/null && diff -q /tmp/station-schema.d.ts src/station/api/schema.d.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "sync:assets": "bash scripts/sync-assets.sh"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-label": "2.1.17",
    "@radix-ui/react-progress": "1.2.1",
    "@radix-ui/react-slot": "1.5.0",
    "@radix-ui/react-switch": "1.4.1",
    "@radix-ui/react-tabs": "1.2.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "@tanstack/react-query": "5.107.1",
    "blockly": "12.5.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "i18next": "24.2.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-i18next": "15.7.4",
    "react-router-dom": "6.30.6",
    "tailwind-merge": "2.6.0",
    "three": "0.186.1",
    "uplot": "1.6.32",
    "urdf-loader": "0.13.1"
  },
  "devDependencies": {
    "@eslint/js": "9.18.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.10",
    "@types/node": "22.10.5",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "4.3.4",
    "@vitest/coverage-v8": "3.2.7",
    "autoprefixer": "10.6.2",
    "axe-core": "4.14.0",
    "eslint": "9.18.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "5.1.0",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "15.14.0",
    "jsdom": "25.0.1",
    "msw": "2.7.0",
    "openapi-typescript": "7.13.0",
    "postcss": "8.5.33",
    "prettier": "3.10.1",
    "tailwindcss": "3.4.17",
    "tailwindcss-animate": "1.0.7",
    "typescript": "5.7.3",
    "typescript-eslint": "8.72.2",
    "vite": "6.4.6",
    "vitest": "3.2.7"
  },
  "pnpm": {
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-5gmw-xhrv-c9v3",
        "GHSA-85c8-ppgw-ccpr",
        "GHSA-mrhx-c7xc-m3w5"
      ]
    }
  }
}
