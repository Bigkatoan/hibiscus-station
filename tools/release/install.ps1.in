# Hibiscus Station @VERSION@ installer for Windows 10/11 x64 (ADR-13, P-1).
#
# Install, update and roll back with one line in PowerShell (no admin rights, no git, no Python):
#   irm @REPO_URL@/releases/download/v@VERSION@/install.ps1 | iex     # exactly this version
@LATEST_LINE@
#
# What it does:
#   1. uses uv @UV_VERSION@ (downloaded once into %LOCALAPPDATA%\HibiscusStation, checked by SHA-256);
#   2. downloads this release's wheel, constraints.txt and overrides.txt and checks them against
#      SHA256SUMS;
#   3. uv tool install --force: Station with exactly the libraries QC tested (constraints.txt is
#      uv.lock; overrides.txt points lerobot and hibiscus at prebuilt wheels of this release, so no
#      git is needed). Python @PYTHON_VERSION@ is installed by uv when missing.
# Your profiles, calibration, datasets, models, trajectories and programs are not touched.
#
# Testing: HIBISCUS_STATION_BASE_URL = a folder or URL holding the release assets (a draft release
# downloaded with `gh release download`); HIBISCUS_STATION_UV = an existing uv executable.
#
# Generated by tools/release/build_release.py from tools/release/install.ps1.in. ASCII only.

& {
    $ErrorActionPreference = 'Stop'
    $ProgressPreference = 'SilentlyContinue'   # Windows PowerShell 5.1 downloads slowly with a progress bar
    Set-StrictMode -Version 2.0

    $Version = '@VERSION@'
    $ReleaseBase = '@BASE_URL@'
    $UvVersion = '@UV_VERSION@'
    $UvAsset = '@UV_ASSET@'
    $UvSha256 = '@UV_SHA256@'
    $PythonVersion = '@PYTHON_VERSION@'
    $PreRelease = $@PRE_RELEASE@
    $Wheel = "hibiscus_station-$Version-py3-none-any.whl"

    function Say([string]$vi, [string]$en) {
        Write-Host "[Hibiscus Station] $vi" -ForegroundColor Cyan
        Write-Host "                   $en"
    }
    function Fail([string]$vi, [string]$en) {
        Write-Host "[Hibiscus Station] LỖI: $vi" -ForegroundColor Red
        Write-Host "                   ERROR: $en" -ForegroundColor Red
        throw "Hibiscus Station install failed: $en"
    }

    $onWindows = ($PSVersionTable.PSEdition -eq 'Desktop') -or ((Get-Variable IsWindows -ErrorAction SilentlyContinue) -and $IsWindows)
    if ($onWindows -and [Environment]::Is64BitOperatingSystem -eq $false) {
        Fail "Station cần Windows 10/11 64-bit (x64)." "Station needs 64-bit Windows 10/11 (x64)."
    }
    try {
        [Net.ServicePointManager]::SecurityProtocol = [Net.ServicePointManager]::SecurityProtocol -bor [Net.SecurityProtocolType]::Tls12
    } catch { }

    # ------------------------------------------------------------------ where the assets come from
    $Base = $ReleaseBase
    if ($env:HIBISCUS_STATION_BASE_URL) { $Base = $env:HIBISCUS_STATION_BASE_URL.TrimEnd('/', '\') }
    $local = $null
    if ($Base -match '^file://') { $local = ([Uri]$Base).LocalPath }
    elseif ($Base -notmatch '^https?://') { $local = (Resolve-Path -LiteralPath $Base).Path }
    $BaseUrl = $Base
    if ($local) {
        $dirUri = [Uri]::new($local.TrimEnd('/', '\') + [IO.Path]::DirectorySeparatorChar, [UriKind]::Absolute)
        $BaseUrl = $dirUri.AbsoluteUri.TrimEnd('/')
    }

    $work = Join-Path ([IO.Path]::GetTempPath()) ("hibiscus-station-install-" + [Guid]::NewGuid().ToString('N'))
    New-Item -ItemType Directory -Path $work | Out-Null

    function Get-Asset([string]$name) {
        $dest = Join-Path $work $name
        if ($local) {
            Copy-Item -LiteralPath (Join-Path $local $name) -Destination $dest
        } else {
            try { Invoke-WebRequest -UseBasicParsing -Uri "$Base/$name" -OutFile $dest }
            catch { Fail "Không tải được $name ($Base). Kiểm tra mạng rồi chạy lại lệnh." "Could not download $name from $Base. Check the network and run the command again." }
        }
        return $dest
    }

    try {
        Say "Đang cài Hibiscus Station $Version. Lần đầu có thể mất 5 – 15 phút (tải khoảng 1 GB)." `
            "Installing Hibiscus Station $Version. The first install can take 5 - 15 minutes (about 1 GB to download)."

        # -------------------------------------------------------------- 1. uv
        $uv = $env:HIBISCUS_STATION_UV
        if (-not $uv) {
            $uvDir = Join-Path $env:LOCALAPPDATA "HibiscusStation\uv-$UvVersion"
            $uv = Join-Path $uvDir 'uv.exe'
            if (-not (Test-Path -LiteralPath $uv)) {
                Say "Đang tải uv $UvVersion (trình cài Python)." "Downloading uv $UvVersion (the Python installer)."
                $zip = Join-Path $work $UvAsset
                try { Invoke-WebRequest -UseBasicParsing -Uri "https://github.com/astral-sh/uv/releases/download/$UvVersion/$UvAsset" -OutFile $zip }
                catch { Fail "Không tải được uv. Kiểm tra mạng rồi chạy lại lệnh." "Could not download uv. Check the network and run the command again." }
                if ((Get-FileHash -Algorithm SHA256 -LiteralPath $zip).Hash.ToLower() -ne $UvSha256) {
                    Fail "Tệp uv tải về bị sai (SHA-256 không khớp)." "The downloaded uv does not match its SHA-256."
                }
                $unz = Join-Path $work 'uv'
                Expand-Archive -LiteralPath $zip -DestinationPath $unz -Force
                $exe = Get-ChildItem -LiteralPath $unz -Recurse -Filter 'uv.exe' | Select-Object -First 1
                if (-not $exe) { Fail "Không thấy uv.exe trong gói uv." "uv.exe is missing from the uv archive." }
                New-Item -ItemType Directory -Path $uvDir -Force | Out-Null
                Get-ChildItem -LiteralPath (Split-Path $exe.FullName) | Copy-Item -Destination $uvDir -Force
            }
        }

        # -------------------------------------------------------------- 2. release assets
        $sums = @{}
        foreach ($line in Get-Content -LiteralPath (Get-Asset 'SHA256SUMS')) {
            if ($line -match '^([0-9a-f]{64})\s+\*?(\S+)$') { $sums[$Matches[2]] = $Matches[1] }
        }
        $files = @{}
        foreach ($name in @($Wheel, 'constraints.txt', 'overrides.txt')) {
            $path = Get-Asset $name
            if (-not $sums.ContainsKey($name) -or (Get-FileHash -Algorithm SHA256 -LiteralPath $path).Hash.ToLower() -ne $sums[$name]) {
                Fail "Tệp $name không khớp SHA256SUMS của bản phát hành." "$name does not match the release's SHA256SUMS."
            }
            $files[$name] = $path
        }
        # overrides.txt names the wheels by their release URL; follow a test location
        if ($BaseUrl -ne $ReleaseBase) {
            $text = [IO.File]::ReadAllText($files['overrides.txt']).Replace($ReleaseBase, $BaseUrl)
            [IO.File]::WriteAllText($files['overrides.txt'], $text)
        }

        # -------------------------------------------------------------- 3. install
        # Only this script's settings count: no uv.toml, no index / torch / resolution variables.
        foreach ($name in @('UV_INDEX', 'UV_INDEX_URL', 'UV_DEFAULT_INDEX', 'UV_EXTRA_INDEX_URL', 'UV_FIND_LINKS',
                            'UV_NO_INDEX', 'UV_TORCH_BACKEND', 'UV_CONSTRAINT', 'UV_OVERRIDE', 'UV_EXCLUDE',
                            'UV_PRERELEASE', 'UV_RESOLUTION', 'UV_EXCLUDE_NEWER', 'UV_INDEX_STRATEGY', 'UV_NO_BINARY',
                            'UV_NO_BUILD', 'UV_SYSTEM_PYTHON', 'UV_PYTHON', 'VIRTUAL_ENV')) {
            Remove-Item -LiteralPath "Env:$name" -ErrorAction SilentlyContinue
        }
        Say "Đang cài thư viện (đúng bộ đã kiểm thử)." "Installing the libraries (the exact tested set)."
        & $uv --no-config tool install --force --python $PythonVersion --managed-python `
            --constraints $files['constraints.txt'] --overrides $files['overrides.txt'] $files[$Wheel]
        if ($LASTEXITCODE -ne 0) {
            Fail "uv không cài được Station (mã $LASTEXITCODE). Chụp màn hình này và gửi cho chúng tôi." `
                 "uv could not install Station (exit code $LASTEXITCODE). Send us a screenshot of this window."
        }

        # -------------------------------------------------------------- 4. PATH and check
        # --color never: under FORCE_COLOR / CLICOLOR_FORCE (CI, some terminals) uv colours the path
        # even into a pipe, and Join-Path then sees a drive named "<ESC>[36mC" (QD-2). The -replace
        # drops any escape sequence that another layer might still add.
        $bin = ((& $uv --no-config --color never tool dir --bin | Select-Object -Last 1) -replace "\x1b\[[0-9;]*[A-Za-z]", '').Trim()
        # Windows PowerShell 5.1 turns redirected native stderr into a terminating error under 'Stop'
        $ErrorActionPreference = 'Continue'
        & $uv --no-config tool update-shell *> $null
        $ErrorActionPreference = 'Stop'
        $sep = [IO.Path]::PathSeparator
        if (-not (($env:PATH -split [regex]::Escape($sep)) -contains $bin)) { $env:PATH = "$bin$sep$env:PATH" }
        $exeName = 'hibiscus-station'
        if ($onWindows) { $exeName = 'hibiscus-station.exe' }
        $got = (& (Join-Path $bin $exeName) --version | Out-String).Trim()
        if ($got -ne "hibiscus-station $Version") {
            Fail "Đã cài nhưng phiên bản là '$got', không phải $Version." "Installed, but the version is '$got', not $Version."
        }

        Write-Host ""
        Say "Xong: $got. Mở cửa sổ PowerShell mới rồi gõ: hibiscus-station" `
            "Done: $got. Open a new PowerShell window and type: hibiscus-station"
        Say "Thử không cần tay robot: hibiscus-station --mock   ·   Có lỗi: hibiscus-station doctor" `
            "Try it without the arms: hibiscus-station --mock   ·   Something wrong: hibiscus-station doctor"
        # A pre-release is never GitHub's "latest" release (QD-1): it is updated by a newer release's line.
        $thisLine = "irm @REPO_URL@/releases/download/v$Version/install.ps1 | iex"
        if ($PreRelease) {
            Say "Đây là bản thử nghiệm (pre-release). Cập nhật: dán dòng cài của bản mới hơn (@REPO_URL@/releases)." `
                "This is a test build (pre-release). Update: paste the install line of a newer release (@REPO_URL@/releases)."
        } else {
            Say "Cập nhật lên bản mới nhất: irm @REPO_URL@/releases/latest/download/install.ps1 | iex" `
                "Update to the latest release: irm @REPO_URL@/releases/latest/download/install.ps1 | iex"
        }
        Say "Quay lại bản này sau khi cập nhật: $thisLine" "Back to this version after an update: $thisLine"
    } finally {
        Remove-Item -LiteralPath $work -Recurse -Force -ErrorAction SilentlyContinue
    }
}
